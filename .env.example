# Exemple de configuration pour le développement local.
# Copie ce fichier en « .env.local » (jamais envoyé sur GitHub) et remplis les valeurs.
# Où les trouver : Supabase → ton projet → Project Settings → API Keys (et Data API pour l'URL).

# Adresse du projet Supabase (ex. https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=
# Clé « publishable » (commence par sb_publishable_…). Elle est publique par nature :
# ne mets JAMAIS ici la clé « secret » (sb_secret_…) ni la clé service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Fonctions Netlify (seulement pour tester /api/* avec `netlify dev`) ---
# En production, ces variables se règlent dans Netlify → Site configuration → Environment variables.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# BREVO_API_KEY=
# SENDER_EMAIL=noreply@cyclami.com
# SENDER_NAME=Cyclami
# SITE_URL=https://cyclami.com
# SUPABASE_AUTH_HOOK_SECRET=
